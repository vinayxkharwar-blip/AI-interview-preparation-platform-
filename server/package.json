{
  "name": "ai-interview-prep-server",
  "version": "1.0.0",
  "description": "Backend server for AI Interview Preparation Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=server.js --watch-path=controllers --watch-path=routes --watch-path=services --watch-path=middleware --watch-path=models --watch-path=config --watch-path=prompts --watch-path=utils server.js",
    "clean-users": "node scripts/cleanInvalidUsers.js",
    "test:auth": "node scripts/test_auth_api.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=60000 --runInBand",
    "test:isolation": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/isolation.test.js --testTimeout=60000 --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.17.0",
    "mammoth": "^1.8.0",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.30.0",
    "pdf-parse": "^1.1.1",
    "validator": "^13.15.35"
  }
}
